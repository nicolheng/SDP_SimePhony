# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini (each person uses their own key)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash
# Backup key for 429 fallback (Day 4)
GOOGLE_API_KEY_BACKUP=

# Team Gmail (SMTP with app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SDP_STAFF_EMAIL=

# Paths / URLs
DB_PATH=data/simephony.db
SEED_DB_PATH=data/seed.db
UPLOADS_DIR=uploads
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
