# =====================================================================
# 1. AI MODEL
# =====================================================================
# Which steps use AI (issue #81). The demo uses only.
# only  = every step uses AI, with no rule-based backup: the AI answer is saved, and a failed AI step shows an
#         error (a new report is held for SDP review). This shows what the AI really does.
# true  = AI first, and the rules take over if an AI step fails. Safer on a slow laptop or a busy free tier.
# false = rule-based stand-ins only, no model needed. A comma list (e.g. comms,triage) runs just those agents.
USE_AI_AGENTS=only

# ---------------------------------------------------------------------
# Pick ONE model setup: A (local Ollama) or B (cloud Gemini).
# To switch: put # in front of every line in one block, remove # from the other, restart the backend,
# then run `python scripts/check_llm.py` (both lines should say OK).
# ---------------------------------------------------------------------

# --- A. LOCAL: Ollama on this laptop (no key, needs `ollama pull qwen2.5:7b` and `ollama pull llava-llama3`) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL_TEXT=qwen2.5:7b
MODEL_VL=llava-llama3
# Seconds per attempt. A laptop is slow, and the first call loads the model
LLM_TIMEOUT_TEXT=45
LLM_TIMEOUT_VISION=90
# Longest JSON answer, which stops a model that runs away producing junk
LLM_MAX_TOKENS=1000
LLM_MAX_RETRIES=1

# --- B. CLOUD: Google Gemini ---
# Free key: https://aistudio.google.com/apikey. Paste it below in .env only, never in git or chat.
# Two models on purpose: each has its own free limit (15 a minute, 500 a day), so one key gets 1,000 a day.
# Text = the quicker model, for the many small text calls. Photo = the newer model, for the harder checks.
# Avoid Gemini 2.5 / 3 Flash: only 20 calls a day. `python scripts/check_llm.py --list` shows all models.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# MODEL_TEXT=gemini-3.1-flash-lite
# MODEL_VL=gemini-3.5-flash-lite
# LLM_TIMEOUT_TEXT=30
# LLM_TIMEOUT_VISION=45
# Gemini thinks before answering and that counts towards this limit, so allow more room and keep thinking low
# LLM_MAX_TOKENS=4000
# LLM_REASONING_EFFORT=low
# Retries wait and try again when the free tier says "too many requests"
# LLM_MAX_RETRIES=3

# Personal-data filter: buyer names, emails, phone numbers and unit numbers are replaced with placeholders
# (PERSON_1, UNIT_1...) before a prompt leaves this machine, and put back in the answer.
# auto = on for a cloud model, off for local Ollama. on / off forces it.
LLM_PRIVACY_FILTER=auto

# ---------------------------------------------------------------------

# false = skip the embedding model used to search for similar past cases
EMBEDDINGS_ENABLED=true

# 2. DATABASE & STORAGE PATHS
# Ensure these match your actual folder structure (backend/ or data/)
DB_PATH=data/simephony.db
SEED_DB_PATH=data/seed.db
UPLOADS_DIR=uploads

# Backend public URL used in case calendar download links
API_BASE_URL=http://localhost:8001

# Optional Google Calendar invitations. Run `python backend/setup_oauth.py` once after saving
# a Google OAuth Desktop app client JSON as backend/oauth-credentials.json.
GOOGLE_CALENDAR_ID=primary

# 3. EMAIL NOTIFICATIONS (Gmail SMTP)
# Use a Gmail App Password for GMAIL_APP_PASSWORD (not your regular Gmail password).
# Set EMAIL_REDIRECT_TO to your real inbox while testing; leave blank to use seed addresses.
GMAIL_ADDRESS=your_team_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_REDIRECT_TO=your_real_email@gmail.com
EMAIL_FROM_NAME=SimePhony Defect Care
SDP_STAFF_EMAIL=sdp_manager@example.com
EMAIL_ENABLED=true

# MCP server port when run with --http
MCP_PORT=8002