# 1. AI MODEL CONFIGURATION (LangGraph + Ollama)
# Demo workflow AI agents: set false for rule-based stand-ins, or use a comma list of agent names.
USE_AI_AGENTS=true

# LLM server (any OpenAI-compatible API; these defaults are local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL_VL=llava-llama3
MODEL_TEXT=qwen2.5:7b

# Seconds per attempt. One retry, so the worst case for a hung server is double this.
LLM_TIMEOUT_TEXT=45
LLM_TIMEOUT_VISION=90
# Stops a model that runs away producing junk instead of finishing its JSON
LLM_MAX_TOKENS=1000

# 2. DATABASE & STORAGE PATHS
# Ensure these match your actual folder structure (backend/ or data/)
DB_PATH=data/simephony.db
SEED_DB_PATH=data/seed.db
UPLOADS_DIR=uploads

# 3. EMAIL NOTIFICATIONS (Gmail SMTP)
# Team Gmail account for sending automated updates
GMAIL_ADDRESS=your_team_email@gmail.com
GMAIL_APP_PASSWORD=your_email_password_here

# SDP Staff email for escalation/approval notifications
SDP_STAFF_EMAIL=sdp_manager@example.com

# false = never send, only write to the outbox table (tests / offline dev)
EMAIL_ENABLED=true
# Optional: deliver every email to this one inbox (seeded buyers use @example.com addresses)
EMAIL_REDIRECT_TO=

# MCP server port when run with --http
MCP_PORT=8002

# 4. API & FRONTEND URLS
API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000