# 1. AI MODEL CONFIGURATION (LangGraph + Ollama)
# Set to "true" to use local Ollama models (Recommended for local dev/testing)
# Set to "false" to use cloud APIs (Groq/Gemini) for the final demo
USE_LOCAL_OLLAMA=true

# Local Ollama Settings
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL_VL=llava-llama3
QWEN_MODEL_TEXT=qwen2.5:7b

# Cloud Fallback Settings (Day 4/5 Demo - Groq is highly recommended for Qwen)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen-2.5-72b-versatile

# 2. DATABASE & STORAGE PATHS
# Ensure these match your actual folder structure (backend/ or data/)
DB_PATH=data/simephony.db
SEED_DB_PATH=data/seed.db
UPLOADS_DIR=uploads

# 3. EMAIL NOTIFICATIONS (Gmail SMTP)
# Team Gmail account for sending automated updates
GMAIL_ADDRESS=your_team_email@gmail.com
GMAIL_APP_PASSWORD=your_email_password_here

# SDP Staff email for escalation/approval notifications
SDP_STAFF_EMAIL=sdp_manager@example.com

# 4. API & FRONTEND URLS
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000