# 1. AI MODEL CONFIGURATION (LangGraph + Ollama)
# Demo workflow AI agents: set false for rule-based stand-ins, or use a comma list of agent names.
USE_AI_AGENTS=true

# LLM server (any OpenAI-compatible API; these defaults are local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL_VL=llava-llama3
MODEL_TEXT=qwen2.5:7b

# Seconds per attempt. One retry, so the worst case for a hung server is double this.
LLM_TIMEOUT_TEXT=45
LLM_TIMEOUT_VISION=90
# Stops a model that runs away producing junk instead of finishing its JSON
LLM_MAX_TOKENS=1000

# false = skip the embedding model used to search for similar past cases
EMBEDDINGS_ENABLED=true

# 2. DATABASE & STORAGE PATHS
# Ensure these match your actual folder structure (backend/ or data/)
DB_PATH=data/simephony.db
SEED_DB_PATH=data/seed.db
UPLOADS_DIR=uploads

# Backend public URL used in case calendar download links
API_BASE_URL=http://localhost:8001

# Optional Google Calendar invitations. Run `python backend/setup_oauth.py` once after saving
# a Google OAuth Desktop app client JSON as backend/oauth-credentials.json.
GOOGLE_CALENDAR_ID=primary

# 3. EMAIL NOTIFICATIONS (Gmail SMTP)
# Use a Gmail App Password for GMAIL_APP_PASSWORD (not your regular Gmail password).
# Set EMAIL_REDIRECT_TO to your real inbox while testing; leave blank to use seed addresses.
GMAIL_ADDRESS=your_team_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_REDIRECT_TO=your_real_email@gmail.com
EMAIL_FROM_NAME=SimePhony Defect Care
SDP_STAFF_EMAIL=sdp_manager@example.com
EMAIL_ENABLED=true

# MCP server port when run with --http
MCP_PORT=8002